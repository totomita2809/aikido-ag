                        <p className="text-2xl font-bold text-slate-900 dark:text-white mt-0.5">
                            {totalCollected.toLocaleString("vi-VN")} đ
                        </p>
                    </div>
                </div>
            </div>

            {/* Bảng danh sách trạng thái đóng học phí */}
