<file path="prisma/schema.prisma">
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                 String  @id @default(cuid())
  name               String?
  email              String? @unique
  username           String? @unique
  passwordHash       String?
  mustChangePassword Boolean @default(false)
  role               String  @default("STUDENT")
  isApproved         Boolean @default(false)
  image              String?

  studentId String?  @unique
  student   Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)

  accounts  Account[]
  sessions  Session[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}


model Student {
  id                 String    @id @default(cuid())
  studentCode        String    @unique
  fullName           String
  currentRank        String
  dojo               String
  email              String?
  healthNote         String?
  dateOfBirth        DateTime?
  gender             String?
  phone              String?
  address            String?
  avatar             String?
  pendingAvatar      String?
  avatarStatus       String    @default("NONE") // NONE, PENDING, APPROVED, REJECTED
  status             String    @default("ACTIVE") // ACTIVE, PAUSED, INACTIVE
  joinDate           DateTime? @default(now())

  // 1. Chức vụ trong võ đường
  title              String    @default("MEMBER") 
  // Giá trị: "MEMBER" (Môn sinh), "FUKU_SHIDOSHA" (Lớp phó), "SHIDOSHA" (Lớp trưởng), "SHIDOIN" (HLV)

  // 2. Trạng thái phê duyệt khi thêm mới
  approvalStatus     String    @default("APPROVED") 
  // Giá trị: "APPROVED" (Đã duyệt), "PENDING_CREATION" (HLV vừa thêm, chờ duyệt), "REJECTED" (Từ chối)
  creatorName        String?   // Họ tên HLV tạo
  creatorCode        String?   // Mã HLV tạo
  rejectReason       String?   // Lý do từ chối (nếu có)

  // Liên kết bảng phân quyền nếu là HLV (Shidoin)
  coachPermission    CoachPermission?

  // Lịch sử sửa thông tin chờ HLV Trưởng duyệt
  pendingChanges     PendingStudentChange[]

  // Các quan hệ đối ứng bắt buộc với User, TuitionFee, Attendance, RankHistory
  user               User?
  tuitionFees        TuitionFee[]
  attendances        Attendance[]
  rankHistories      RankHistory[]

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

// Bảng phân quyền thao tác chi tiết dành riêng cho HLV
model CoachPermission {
  id               String   @id @default(cuid())
  studentId        String   @unique
  student          Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  // Thêm mới môn sinh: EDIT (Chỉnh sửa) hoặc VIEW (Chỉ xem)
  canCreateStudent String   @default("VIEW") 

  // Quyền sửa từng trường dữ liệu: "EDIT" hoặc "VIEW"
  canEditFullName  String   @default("VIEW")
  canEditRank      String   @default("VIEW")
  canEditDojo      String   @default("VIEW")
  canEditDob       String   @default("VIEW")
  canEditGender    String   @default("VIEW")
  canEditPhone     String   @default("VIEW")
  canEditAddress   String   @default("VIEW")
  canEditHealth    String   @default("VIEW")
  canEditStatus    String   @default("VIEW")
  
  updatedAt        DateTime @updatedAt
}



// Bảng tạm lưu các thông tin mà HLV đã sửa, chờ HLV Trưởng ấn duyệt mới ghi đè vào Student
model PendingStudentChange {
  id           String   @id @default(cuid())
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  coachId      String?
  coachName    String   // Tên HLV thực hiện sửa
  coachCode    String?

  changedData  String   // Dữ liệu JSON chứa các trường đã sửa
  status       String   @default("PENDING") // PENDING, APPROVED, REJECTED
  rejectReason String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
}




model RankHistory {
  id            String   @id @default(cuid())
  studentId     String
  rank          String
  examDate      DateTime
  examiner      String?
  certificateNo String?
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique // Ví dụ: "logo_folder", "app_logo"
  value     String // Đường dẫn ảnh hoặc thư mục: "/logo/aikido-ag.png"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TuitionFee {
  id            String    @id @default(cuid())
  studentId     String
  student       Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  month         Int // Tháng thu (1 - 12)
  year          Int // Năm thu (VD: 2026)
  amount        Float     @default(0) // Số tiền
  isPaid        Boolean   @default(false) // Trạng thái đã nộp
  paidAt        DateTime? // Ngày nộp thực tế
  paymentMethod String? // Tiền mặt / Chuyển khoản
  receiptUrl    String? // Lưu ảnh biên lai chuyển khoản
  note          String? // Ghi chú
  createdAt     DateTime  @default(now())

  @@unique([studentId, month, year])
}


model Attendance {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date // Lưu ngày tập (bỏ phần giờ phút)
  status    String   @default("PRESENT") // "PRESENT" (Có mặt) hoặc "ABSENT" (Vắng)
  note      String?
  createdAt DateTime @default(now())

  @@unique([studentId, date])
}
</file>

<file path="prisma/seed.ts">
import { PrismaClient } from "@prisma/client";
import bcrypt from "bcryptjs";

const prisma = new PrismaClient();

async function main() {
    const adminPass = await bcrypt.hash("admin123456", 10);
    const coachPass = await bcrypt.hash("coach123456", 10);

    await prisma.user.upsert({
        where: { username: "admin" },
        update: {
            passwordHash: adminPass,
            role: "SUPER_ADMIN",
            isApproved: true,
        },
        create: {
            username: "admin",
            name: "Nguyễn Trần Anh Vũ",
            passwordHash: adminPass,
            role: "SUPER_ADMIN",
            isApproved: true,
        },
    });

    await prisma.user.upsert({
        where: { username: "coach" },
        update: {
            passwordHash: coachPass,
            role: "COACH",
            isApproved: true,
        },
        create: {
            username: "coach",
            name: "Huấn Luyện Viên",
            passwordHash: coachPass,
            role: "COACH",
            isApproved: true,
        },
    });

    console.log("-----------------------------------------");
    console.log("Khởi tạo tài khoản thành công:");
    console.log("1. Super Admin -> user: admin | pass: admin123456");
    console.log("2. HLV         -> user: coach | pass: coach123456");
    console.log("-----------------------------------------");
}

main()
    .catch((e) => {
        console.error(e);
        process.exit(1);
    })
    .finally(async () => {
        await prisma.$disconnect();
    });
</file>

