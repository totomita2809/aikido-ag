                    </div>
                ) : (
                    <div className="grid grid-cols-1 md:grid-cols-2 gap-3">
                        {guestStudents.map((s) => renderStudentCard(s, true))}
                    </div>
                )}
            </div>
        </form>
    );
}
</file>

